<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>BreakBoss</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <!-- Keeps playing when you switch apps (e.g. while a DAW records it through Inter-App audio routing). -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    <!-- Shows the app's Documents folder in Files ("On My iPad › BreakBoss"): Samples, Kits,
         Presets and Exports live there. -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
</dict>
</plist>
